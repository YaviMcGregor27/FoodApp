# Copia este archivo como .env y rellena los valores del proyecto de Supabase
# (Project Settings > API). La clave pública es segura en la app: la base de datos
# solo permite lo que autorizan sus políticas de seguridad.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=TU_CLAVE_PUBLICA
